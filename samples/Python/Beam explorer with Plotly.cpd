"Continuous beam: Python solves, Plotly explores
'A three-span beam is analysed by the direct stiffness method in a <b>#python</b> block (numpy arrays and a small solver). The same block builds the chart with the Plotly API (<code>import plotly.graph_objects as go</code>) and shows it with <code>fig.show()</code>: no HTML and no JavaScript in this worksheet. The menu and the two sliders are the native Plotly controls (<code>updatemenus</code> and <code>sliders</code>), and the results are exported back so that Calcpad can check them against a capacity.
'<p><b>What is live.</b> The Python solve runs once, when the worksheet is calculated, and every slider step is a precomputed result. A Plotly control cannot read another control, so each one owns its own traces: the menu chooses which uniform load case is drawn, the load factor slider multiplies that uniform load (exact, the analysis is linear), and the position slider moves the point load, drawn in orange on top. Changing a span or a load means editing the numbers at the top of the Python block, which recalculates the worksheet.</p>
"Python: direct stiffness solve
#python
import numpy as np
import plotly.graph_objects as go
from plotly.subplots import make_subplots

# Three-span continuous beam by the direct stiffness method.
# Units: m, kN, kN*m.  Edit the numbers, then the whole explorer below follows.
spans = [5.0, 6.0, 4.0]      # span lengths, m
EI = 20000.0                 # bending stiffness, kN*m^2 (E = 200 GPa, I = 1.0e8 mm^4)
w = 20.0                     # uniform load, kN/m
P = 60.0                     # point load, kN
N = 24                       # points per span for the diagrams


def solve(A, b):
    """Gaussian elimination with partial pivoting (the light numpy has no linalg)."""
    n = len(b)
    M = [list(A[i]) + [b[i]] for i in range(n)]
    for c in range(n):
        p = max(range(c, n), key=lambda r: abs(M[r][c]))
        M[c], M[p] = M[p], M[c]
        for r in range(c + 1, n):
            f = M[r][c] / M[c][c]
            for k in range(c, n + 1):
                M[r][k] -= f * M[c][k]
    x = [0.0] * n
    for i in range(n - 1, -1, -1):
        x[i] = (M[i][n] - sum(M[i][k] * x[k] for k in range(i + 1, n))) / M[i][i]
    return x


def fixed_end(L, q, a=None):
    """End reactions (up, anticlockwise) of a fixed-fixed span under a uniform load q or a point load q at a."""
    if a is None:
        return [q * L / 2, q * L * L / 12, q * L / 2, -q * L * L / 12]
    b = L - a
    return [q * b * b * (3 * a + b) / L**3, q * a * b * b / L**2,
            q * a * a * (3 * b + a) / L**3, -q * a * a * b / L**2]


def fixed_defl(L, x, q, a=None):
    """Downward deflection of that fixed-fixed span at x."""
    if a is None:
        return q * x * x * (L - x) ** 2 / (24 * EI)
    if x > a:
        return fixed_defl(L, L - x, q, L - a)
    b = L - a
    return q * b * b * x * x * (3 * a * L - x * (3 * a + b)) / (6 * L**3 * EI)


def analyse(load):
    """load[i] = None | ('u', q) | ('p', P, a) for span i.  Returns x, V, M, y (deflection, mm), reactions."""
    n = len(spans)
    K = [[0.0] * (n + 1) for _ in range(n + 1)]       # only the rotation DOFs: every support holds w = 0
    F = [0.0] * (n + 1)
    fes = []
    for i, L in enumerate(spans):
        k = EI / L
        K[i][i] += 4 * k
        K[i + 1][i + 1] += 4 * k
        K[i][i + 1] += 2 * k
        K[i + 1][i] += 2 * k
        ld = load[i]
        fe = [0.0] * 4
        if ld is not None:
            fe = fixed_end(L, ld[1]) if ld[0] == 'u' else fixed_end(L, ld[1], ld[2])
        fes.append(fe)
        F[i] -= fe[1]
        F[i + 1] -= fe[3]
    th = solve(K, F)
    xs, Vs, Ms, ys = [], [], [], []
    react = [0.0] * (n + 1)
    x0 = 0.0
    for i, L in enumerate(spans):
        t1, t2 = th[i], th[i + 1]
        fe = fes[i]
        k = EI / L
        V1 = 6 * k / L * (t1 + t2) + fe[0]            # end shear, up at the left end
        M1 = k * (4 * t1 + 2 * t2) + fe[1]            # end moment at the left end
        V2 = -6 * k / L * (t1 + t2) + fe[2]
        react[i] += V1
        react[i + 1] += V2
        ld = load[i]
        for j in range(N):
            x = L * j / (N - 1)
            q = ld[1] if ld and ld[0] == 'u' else 0.0
            pa = ld[2] if ld and ld[0] == 'p' else None
            Pp = ld[1] if ld and ld[0] == 'p' else 0.0
            after = pa is not None and x > pa
            V = V1 - q * x - (Pp if after else 0.0)
            M = -M1 + V1 * x - q * x * x / 2 - (Pp * (x - pa) if after else 0.0)
            s = x / L
            herm = L * (s * (1 - s) ** 2 * t1 + (s * s * (s - 1)) * t2)       # rotation part, up positive
            d = -(herm - (fixed_defl(L, x, ld[1], None if ld[0] == 'u' else ld[2]) if ld else 0.0))
            xs.append(x0 + x)
            Vs.append(V)
            Ms.append(M)
            ys.append(1000.0 * d)                       # downward deflection, mm
        x0 += L
    return xs, Vs, Ms, ys, react


total = sum(spans)
cases = {
    "udl_all": [('u', w), ('u', w), ('u', w)],
    "udl_13": [('u', w), None, ('u', w)],
    "udl_2": [None, ('u', w), None],
}
case_names = ["UDL on all spans", "UDL on spans 1 and 3", "UDL on span 2 only"]
M_u, V_u, y_u, R_u = [], [], [], []
for key in ("udl_all", "udl_13", "udl_2"):
    xs, V, M, y, R = analyse(cases[key])
    V_u.append(V)
    M_u.append(M)
    y_u.append(y)
    R_u.append(R)

# a point load P stepped along the beam, one solve per position
pos = [0.5 + k for k in range(int(total))]
M_p, V_p, y_p, R_p = [], [], [], []
for pk in pos:
    load, x0 = [None] * len(spans), 0.0
    for i, L in enumerate(spans):
        if x0 <= pk <= x0 + L:
            load[i] = ('p', P, pk - x0)
            break
        x0 += L
    _, V, M, y, R = analyse(load)
    V_p.append(V)
    M_p.append(M)
    y_p.append(y)
    R_p.append(R)

x = np.array(xs)
Mu = np.array(M_u)
M_hi = np.maximum(np.maximum(Mu[0], Mu[1]), Mu[2])
M_lo = np.minimum(np.minimum(Mu[0], Mu[1]), Mu[2])
print("Spans", spans, "m, EI", EI, "kN*m^2, w", w, "kN/m, P", P, "kN")
print("Equilibrium: the reactions sum to the load for every case")
print("  UDL on all spans", round(sum(R_u[0]), 3), "of", w * total, "kN;  point load, worst of", len(pos), "positions: error",
      round(max(abs(sum(r) - P) for r in R_p), 9), "kN")
print("Largest values (kN, kN*m, mm) at the load factor 1:")
for i, nm in enumerate(case_names):
    print("  %-22s sagging %7.2f  hogging %7.2f  shear %7.2f  deflection %6.2f" % (nm, max(M_u[i]), min(M_u[i]),
          max(max(V_u[i]), -min(V_u[i])), max(y_u[i])))

# ---- the chart: Plotly API, native controls, precomputed steps ----
BLUE, ORANGE = "#1f77b4", "#e07000"
xr = [round(v, 3) for v in xs]
sc = lambda a, f, n=2: [round(v * f, n) for v in a]      # a diagram times a load factor, rounded for the page
facs = [round(0.5 + 0.05 * k, 2) for k in range(31)]      # load factors 0.50 ... 2.00
k0, f0 = 3, 10                                            # first position (3.5 m) and factor (1.00) shown

fig = make_subplots(rows=3, cols=1, shared_xaxes=True, vertical_spacing=0.08, row_heights=[0.4, 0.3, 0.3],
                    subplot_titles=["Bending moment M (kN.m), sagging down", "Shear force V (kN)", "Deflection (mm), downward"])
hi, lo = M_hi.tolist(), M_lo.tolist()
fig.add_trace(go.Scatter(x=xr, y=sc(hi, 1), mode="lines", line_width=0, hoverinfo="skip", showlegend=False), row=1, col=1)          # 0
fig.add_trace(go.Scatter(x=xr, y=sc(lo, 1), mode="lines", line_width=0, fill="tonexty", fillcolor="rgba(128,128,128,0.25)",
                         hoverinfo="skip", name="envelope of the three UDL cases"), row=1, col=1)                                       # 1
panels = [("M", "M = %{y:.2f} kN.m", M_u, M_p, 2), ("V", "V = %{y:.2f} kN", V_u, V_p, 2), ("y", "deflection = %{y:.2f} mm", y_u, y_p, 3)]
for i, nm in enumerate(case_names):                                                                                                    # 2 ... 10
    for r, (key, unit, ud, pt, nd) in enumerate(panels):
        fig.add_trace(go.Scatter(x=xr, y=sc(ud[i], 1, nd), mode="lines", line=dict(color=BLUE, width=2.5), fill="tozeroy", fillcolor="rgba(31,119,180,0.15)",
                                 name=nm, legendgroup="udl" + str(i), showlegend=(r == 0), visible=(i == 0),
                                 hovertemplate="x = %{x:.2f} m<br>" + unit + "<extra>" + nm + "</extra>"), row=r + 1, col=1)
pname = lambda k: "P = %g kN at x = %.1f m" % (P, pos[k])
for r, (key, unit, ud, pt, nd) in enumerate(panels):                                                                                   # 11 ... 13
    fig.add_trace(go.Scatter(x=xr, y=sc(pt[k0], 1, nd), mode="lines", line=dict(color=ORANGE, width=2.5), name=pname(k0), legendgroup="pt",
                             showlegend=(r == 0), hovertemplate="x = %{x:.2f} m<br>" + unit + "<extra>point load</extra>"), row=r + 1, col=1)
UDL = list(range(11))          # the traces the load factor owns: the band and the three uniform cases
PT = [11, 12, 13]              # the traces the position slider owns


def udl_at(f):
    """The y data of the traces in UDL (the band, then M, V and deflection of each uniform case) for a load factor."""
    ys = [sc(hi, f), sc(lo, f)]
    for i in range(3):
        ys += [sc(M_u[i], f), sc(V_u[i], f), sc(y_u[i], f, 3)]
    return ys


def point_at(k):
    """The y data of the traces in PT (M, V and deflection) for position number k."""
    return [sc(M_p[k], 1), sc(V_p[k], 1), sc(y_p[k], 1, 3)]

sup = [0.0]
for L in spans:
    sup.append(sup[-1] + L)
for s in sup:
    fig.add_shape(type="line", xref="x", yref="paper", x0=s, x1=s, y0=0, y1=1, line=dict(color="#888", width=1, dash="dot"))             # shapes 0 ... 3
fig.add_shape(type="line", xref="x", yref="paper", x0=pos[k0], x1=pos[k0], y0=0, y1=1, line=dict(color=ORANGE, width=2))                # shape 4: the point load


def shown(case):
    """Which of the 14 traces show for a menu entry: the point load always, the band and one uniform case (none for the last entry)."""
    v = [case < 3, case < 3] + [False] * 9 + [True] * 3
    for i in range(3):
        v[2 + 3 * i:5 + 3 * i] = [i == case] * 3
    return v


fig.update_layout(
    title=dict(text="Three-span beam: M, V and deflection", x=0, xanchor="left", y=0.99, yanchor="top"),
    height=960, margin=dict(l=64, r=16, t=200, b=190), hovermode="x", legend=dict(orientation="h", x=0, y=1.175, yanchor="top"),
    xaxis3_title="x (m)", yaxis_title="M", yaxis_autorange="reversed", yaxis2_title="V", yaxis3_title="y", yaxis3_autorange="reversed",
    updatemenus=[dict(type="dropdown", direction="down", x=0, xanchor="left", y=1.263, yanchor="top",
                      buttons=[dict(label=nm, method="update", args=[{"visible": shown(c)}]) for c, nm in enumerate(case_names + ["No uniform load (point load only)"])])],
    sliders=[
        dict(active=k0, x=0, len=1, y=-0.1, yanchor="top", pad=dict(t=40, b=0), currentvalue=dict(prefix="Point load P = %g kN at x = " % P, suffix=" m"),
             steps=[dict(label="%.1f" % pos[k], method="update",
                         args=[{"y": point_at(k), "name": [pname(k)] * 3}, {"shapes[4].x0": pos[k], "shapes[4].x1": pos[k]}, PT])
                    for k in range(len(pos))]),
        dict(active=f0, x=0, len=1, y=-0.1, yanchor="top", pad=dict(t=130, b=0), currentvalue=dict(prefix="Uniform load factor (w = %g kN/m times the factor) = " % w),
             steps=[dict(label="%.2f" % f, method="restyle",
                         args=[{"y": udl_at(f)}, UDL])
                    for f in facs]),
    ])
fig.show()
print("The chart holds", len(fig.to_json()) // 1000, "kB of precomputed results.")

export(L_1=spans[0], L_2=spans[1], L_3=spans[2], w_k=w, P_k=P, EI_k=EI)
# the envelope and the reactions as data for the checks below (defined, not printed)
export_data(M_hi=M_hi, M_lo=M_lo)
export_data(R_u=R_u, y_u=y_u)
#end python
"Design check in Calcpad
'The envelope and the reactions are Calcpad variables now, so the usual units and checks apply.
M_sag = max(M_hi)
M_hog = min(M_lo)
M_Ed = max(M_sag; -M_hog)*1kN*m
M_Rd = 150kN*m
η = M_Ed/M_Rd
#if η ≤ 1
	'The largest bending moment of the three load cases is within the capacity.
#else
	'The largest bending moment of the three load cases exceeds the capacity.
#end if
R_max = max(R_u)*1kN
δ_max = max(y_u)*1mm
