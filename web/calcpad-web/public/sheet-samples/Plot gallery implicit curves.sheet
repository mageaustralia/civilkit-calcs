# Plot gallery: implicit curves, functions and polylines

A worksheet page in the style of a plotting demo: the definitions at the top, then four plots on a grid. Each plot mixes **implicit curves** (f(x, y) = 0, drawn as a contour at level zero), **functions** of x, **parametric** curves and **polylines** with markers. The plots are drawn in a python fence with the Plotly API, so everything can be zoomed and read by hovering. The fourth plot has a second y axis on the right.

## Definitions

$$f(x,y)=x^{4}+y^{4}+0.4\sin(7x)+0.3\sin(4\pi y)-1 \qquad g(x)=-x^{2}$$

$$f_1(x,y)=\sin^{2}(5x)+\cos^{2}(5y)-0.8 \qquad g_1(x)=\cos(4x)$$

$$h(x,k)=-k\,x^{2}-1 \qquad \text{heart: } (x^{2}+y^{2}-1)^{3}-x^{2}y^{3}=0$$

## Python: the four plots

```python
import math
import plotly.graph_objects as go
from plotly.subplots import make_subplots

N = 141
R = 1.5
xs = [-R + 2 * R * i / (N - 1) for i in range(N)]
ys = list(xs)


def grid(fn):
    """fn(x, y) on the plot window, rows follow y (what a contour trace wants)."""
    return [[fn(x, y) for x in xs] for y in ys]


def implicit(fn, colour, name=None, width=1.6, legend=False):
    """The curve fn(x, y) = 0: a contour trace with a single level at zero, drawn as a line."""
    return go.Contour(x=xs, y=ys, z=grid(fn), showscale=False, ncontours=1, name=name or "", showlegend=legend,
                      contours=dict(start=0, end=0, size=1, coloring="lines", showlabels=False),
                      colorscale=[[0, colour], [1, colour]], line=dict(width=width), hoverinfo="skip")


def curve(fx, colour, name, t0=-R, t1=R, n=400, width=1.6, legend=False):
    ts = [t0 + (t1 - t0) * i / (n - 1) for i in range(n)]
    return go.Scatter(x=ts, y=[fx(t) for t in ts], mode="lines", name=name, showlegend=legend,
                      line=dict(color=colour, width=width))


def poly(points, colour, name, marker="square", size=9, line=True, legend=False):
    return go.Scatter(x=[p[0] for p in points], y=[p[1] for p in points], name=name, showlegend=legend,
                      mode="lines+markers" if line else "markers",
                      line=dict(color=colour, width=1.5),
                      marker=dict(symbol=marker, size=size, color="rgba(0,0,0,0)", line=dict(color=colour, width=1.8)))


BLUE, RED, GREEN, MAGENTA, ORANGE, BROWN, BLACK = "#2a4fd8", "#e03030", "#2f9e44", "#d63cc8", "#f08a00", "#8a4b12", "#111111"
pi = math.pi

# --- plot 1: f(x, y) = 0 with functions and two polylines
M = [(-1.2, 1.2), (1.2, 1.2), (1.2, -1.2), (-1.2, -1.2), (-1.2, 0.0)]            # 1.2 * the corner points
S = [(-1.0, -1.0), (-0.5, -1.0), (-0.5, -0.5), (0.5, 0.5), (0.5, 1.0), (1.0, 1.0)]
p1 = [
    implicit(lambda x, y: x ** 4 + y ** 4 + 0.4 * math.sin(7 * x) + 0.3 * math.sin(4 * pi * y) - 1, BLACK),
    curve(lambda x: -x, RED, "-x"),
    curve(lambda x: -x * x, GREEN, "g(x)"),
    curve(lambda x: math.sin(4 * x), MAGENTA, "sin(4x)"),
    poly(M, ORANGE, "M"),
    poly(S, BROWN, "S", marker="circle", size=10),
]

# --- plot 2: f1(x, y) = 0 and g1(x), with a legend
p2 = [
    implicit(lambda x, y: math.sin(5 * x) ** 2 + math.cos(5 * y) ** 2 - 0.8, BLUE, "f1(x,y)", legend=True),
    curve(lambda x: math.cos(4 * x), RED, "g1(x)", legend=True),
]

# --- plot 3: "Examples" - x = f(y), g(x, y) = 0, an oscillation, noise, two implicit shapes
seed = [7]


def noise():
    seed[0] = (seed[0] * 1103515245 + 12345) % 2147483648
    return 0.1 * (seed[0] // 65536 % 5) - 1.25                                    # 0.1 * random(5) - 1.25


ysamp = [-R + 2 * R * i / 399 for i in range(400)]
p3 = [
    go.Scatter(x=[y * y - 1 for y in ysamp], y=ysamp, mode="lines", line=dict(color=BLUE, width=1.6), showlegend=False,
               name="f(y)=y^2-1"),
    implicit(lambda x, y: y + x * x - 1, RED),
    curve(lambda x: 0.5 * math.sin(25 * x) * math.cos(x), MAGENTA, "0.5 sin(25t) cos(t)", n=900, width=1.2),
    go.Scatter(x=[-R + 2 * R * i / 119 for i in range(120)], y=[noise() for i in range(120)], mode="lines",
               line=dict(color=ORANGE, width=1.0), showlegend=False, name="noise"),
    implicit(lambda x, y: abs(x) ** (2 / 3) + abs(y) ** (2 / 3) - 1.5, GREEN),
    implicit(lambda x, y: x ** 16 + y ** 16 - 1, RED),
]

# --- plot 4: heart, a quintic, a wobbly ring, h(x, 0.2), a polyline, and a second y axis (right)
M2 = [(0.5, -1.0), (-0.5, 1.0), (-1.0, -1.0)]
p4 = [
    implicit(lambda x, y: (x * x + y * y - 1) ** 3 - x * x * y ** 3, RED, width=2.0),
    implicit(lambda x, y: x ** 5 + y ** 5 - x * y * y, BLUE),
    implicit(lambda x, y: x * x + y * y - math.sin(5 * (x + y)) ** 2 - math.cos(4 * (x - y)) ** 2, BLACK, width=1.4),
    curve(lambda x: -0.2 * x * x - 1, BLUE, "h(x,0.2)", width=1.8),
    poly(M2, ORANGE, "M", marker="x", size=8),
]
y2 = go.Scatter(x=[-1.4, 0.2, 1.4], y=[-1.6, 1.0, 0.3], mode="lines", line=dict(color=GREEN, width=1.6), showlegend=False,
                name="y2", xaxis="x4", yaxis="y5")

fig = make_subplots(rows=2, cols=2, subplot_titles=("PLOT", "PLOT1", "Examples", "PLOT1"),
                    horizontal_spacing=0.09, vertical_spacing=0.1)
for r, c, tr in ((1, 1, p1), (1, 2, p2), (2, 1, p3), (2, 2, p4)):
    for t in tr:
        fig.add_trace(t, row=r, col=c)
fig.add_trace(y2)

axis = dict(range=[-R, R], dtick=0.5, showgrid=True, gridcolor="#d9dde3", zeroline=True, zerolinecolor="#111111",
            showline=True, linecolor="#111111", mirror=True, ticks="outside")
fig.update_xaxes(axis, title=dict(text="x"))
fig.update_yaxes(axis, title=dict(text="y"))
fig.update_layout(
    height=900, margin=dict(l=60, r=70, t=40, b=50),
    legend=dict(x=0.99, y=0.99, xanchor="right", yanchor="top", bordercolor="#888", borderwidth=1),
    yaxis5=dict(overlaying="y4", anchor="x4", side="right", range=[-2, 2], dtick=0.5, showgrid=False, title=dict(text="y2")),
)
fig.show()
```
